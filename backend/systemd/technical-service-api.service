[Unit]
Description=Technical Service API (FastAPI)
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/technical_service_app/backend
Environment="PATH=/var/www/technical_service_app/backend/venv/bin"
ExecStart=/var/www/technical_service_app/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4 --log-level info --no-access-log --proxy-headers --forwarded-allow-ips "*"
Restart=always
RestartSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/technical_service_app/backend

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=technical-service-api

[Install]
WantedBy=multi-user.target
